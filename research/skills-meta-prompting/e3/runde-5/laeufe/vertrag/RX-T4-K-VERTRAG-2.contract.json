      "evidenzstufe": "im Code gefunden",
      "codeaussage": true,
      "zitate": 2
    },
    {
      "zeile": 20,
      "aussage": "`checkDigit` selbst rechnet nach dem GS1-Verfahren: Gewichte 3 und 1 von rechts, die rechte Ziffer des Rumpfs bekommt Gewicht 3, Ergebnis (10 − Summe mod 10) mod 10. Es gibt keine Prüfung auf Nicht-Ziffern im Rumpf.",
      "quellenrolle": "Code",
      "evidenzstufe": "im Code gefunden",
      "codeaussage": true,
      "zitate": 1
    },
    {
      "zeile": 21,
