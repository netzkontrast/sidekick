  "befunde": [
    {
      "zeile": 11,
      "aussage": "Die README verspricht „exponentielles Backoff (bis zu 5 Versuche)“, Prüfung per SHA-256 nach dem Upload und „Zugangsdaten erscheinen nie in Logs“.",
      "quellenrolle": "Herstellerbehauptung",
      "evidenzstufe": "dokumentiert",
      "codeaussage": false,
      "zitate": 1
    },
    {
      "zeile": 12,
      "aussage": "Wiederholungen: höchstens 3 Versuche mit festem Abstand von 100 ms, ohne wachsenden Abstand. Das widerspricht der README.",
      "quellenrolle": "Code",
      "evidenzstufe": "im Code gefunden",
      "codeaussage": true,
      "zitate": 2
    },
    {
      "zeile": 13,
      "aussage": "Jeder Fehler wird wiederholt, auch dauerhafte HTTP-Fehler wie 4xx. Ob ein Fehler vorübergehend ist, wird nicht unterschieden.",
      "quellenrolle": "Code",
      "evidenzstufe": "im Code gefunden",
      "codeaussage": true,
      "zitate": 2
    },
    {
      "zeile": 14,
      "aussage": "Integrität: Es wird MD5 berechnet, nicht SHA-256. Ein Vergleich mit der Serverantwort nach dem Upload fehlt. Das ETag wird nur ungeprüft zurückgegeben.",
      "quellenrolle": "Code",
      "evidenzstufe": "im Code gefunden",
      "codeaussage": true,
      "zitate": 3
    },
    {
      "zeile": 15,
      "aussage": "`content-md5` wird als Hex gesendet. Für den Header ist Base64 üblich. Ob der Zielspeicher das ablehnt oder die Prüfung überspringt, wurde nicht getestet.",
      "quellenrolle": "Code",
      "evidenzstufe": "offen",
      "codeaussage": true,
      "zitate": 2
    },
    {
      "zeile": 16,
      "aussage": "Bei `debug: true` wird das gesamte `options`-Objekt geloggt. Die README übergibt dort `accessKey` und `secretKey`, die Zugangsdaten landen also im Log.",
      "quellenrolle": "Code",
      "evidenzstufe": "im Code gefunden",
      "codeaussage": true,
      "zitate": 2
    },
    {
      "zeile": 17,
      "aussage": "`accessKey` und `secretKey` werden für die Anfrage nirgends genutzt. Der PUT geht ohne Signatur oder Authentifizierungs-Header hinaus. Gesucht wurde im Paket nach `accessKey`, `secretKey` und Authorization-Headern.",
      "quellenrolle": "Code",
      "evidenzstufe": "im Code gefunden",
      "codeaussage": true,
      "zitate": 1
    },
    {
      "zeile": 18,
      "aussage": "Ob ein Upload ohne Signatur gegen den eingesetzten Objektspeicher überhaupt gelingt, ist nicht getestet. Gegen gewöhnliches S3 mit privatem Bucket ist eine Ablehnung zu erwarten.",
      "quellenrolle": "Code",
      "evidenzstufe": "offen",
      "codeaussage": true,
      "zitate": 1
    },
    {
      "zeile": 19,
      "aussage": "Der Objektschlüssel ist der unveränderte lokale Dateipfad, ohne Encoding. Bei absoluten Pfaden oder Sonderzeichen entstehen unerwartete Schlüssel.",
      "quellenrolle": "Code",
      "evidenzstufe": "im Code gefunden",
      "codeaussage": true,
      "zitate": 1
    },
    {
      "zeile": 20,
      "aussage": "Die ganze Datei wird mit `readFileSync` in den Speicher geladen. Bei großen Dumps kann das den Speicher sprengen und blockiert den Prozess.",
      "quellenrolle": "Code",
      "evidenzstufe": "im Code gefunden",
      "codeaussage": true,
      "zitate": 1
    },
    {
      "zeile": 21,
      "aussage": "Version 3.1.0, Lizenz MIT laut Paketangabe. Herkunft und Upstream-Repo sind nicht angegeben. Eine Lizenzdatei fehlt im Paket.",
      "quellenrolle": "Herstellerbehauptung",
      "evidenzstufe": "dokumentiert",
      "codeaussage": false,
      "zitate": 1
    },
