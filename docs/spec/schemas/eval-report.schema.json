{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sidekick.invalid/spec/skill-library-v0/eval-report.schema.json",
  "title": "Eval-Bericht – Skill-Library V0",
  "description": "Deskriptiver Bericht ausschließlich aus Rohdatensätzen (SLV0-EVAL-10, SLV0-INV-09). Jede Zahl trägt Zähler, Nenner und die Rohdatensatz-IDs. Ebenen M0–M5 und R getrennt, Familien und Wiederholungen getrennt. R-Verstöße je Fall getrennt und nie mit anderen Ergebnissen verrechnet (SLV0-EVAL-11). Rubrikversionen werden genannt und nie gemischt (SLV0-EVAL-15). Kein Score, keine Rangfolge, keine Aktivierungsempfehlung (SLV0-INV-06): additionalProperties ist überall false.",
  "type": "object",
  "required": ["schema_version", "bericht", "hinweis", "rohdaten", "rubrik_versionen", "ebenen", "r_pruefungen", "r_verstoesse"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "bericht": { "const": "sl-eval-report@1" },
    "hinweis": { "type": "string" },
    "rohdaten": {
      "type": "object",
      "required": ["anzahl", "rohdatensatz_ids", "eingabe_sha256"],
      "additionalProperties": false,
      "properties": {
        "anzahl": { "type": "integer", "minimum": 1 },
        "rohdatensatz_ids": { "$ref": "#/$defs/ids" },
        "eingabe_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 über das kanonische JSON der nach run_id sortierten Rohdatensätze." }
      }
    },
    "rubrik_versionen": {
      "type": "array",
      "description": "Je in den Rohdaten genannter rubrik_version die Rohdatensätze (SLV0-EVAL-15). Nie zwei Versionen derselben Rubrik; Rohdatensätze ohne rubrik_version erscheinen nicht.",
      "items": {
        "type": "object",
        "required": ["rubrik_version", "rohdatensatz_ids"],
        "additionalProperties": false,
        "properties": {
          "rubrik_version": { "type": "string", "minLength": 1 },
          "rohdatensatz_ids": { "$ref": "#/$defs/ids" }
        }
      }
    },
    "ebenen": {
      "type": "object",
      "propertyNames": { "enum": ["M0", "M1", "M2", "M3", "M4", "M5", "R"] },
      "additionalProperties": { "$ref": "#/$defs/ebene" }
    },
    "r_pruefungen": {
      "type": "array",
      "description": "Je Fall, Variante und Regel: Verstöße (nicht_bestanden) von allen R-Assertions.",
      "items": {
        "type": "object",
        "required": ["case_id", "variante", "regel", "verstoesse", "unklar"],
        "additionalProperties": false,
        "properties": {
          "case_id": { "type": "string" },
          "variante": { "type": "string" },
          "regel": { "type": "string" },
          "verstoesse": { "$ref": "#/$defs/zahl" },
          "unklar": { "$ref": "#/$defs/zahl" }
        }
      }
    },
    "hinweise": {
      "type": "array",
      "description": "Hinweise ohne Einfluss auf Zahlen, z. B. no_discriminating_check je Fall, dessen deterministische Assertions alle markiert und nicht trennend sind (SLV0-EVAL-24).",
      "items": {
        "type": "object",
        "required": ["code", "rule", "case_id", "assertion_ids", "rohdatensatz_ids", "message"],
        "additionalProperties": false,
        "properties": {
          "code": { "const": "no_discriminating_check" },
          "rule": { "const": "SLV0-EVAL-24" },
          "case_id": { "type": "string" },
          "assertion_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "rohdatensatz_ids": { "$ref": "#/$defs/ids" },
          "message": { "type": "string" }
        }
      }
    },
    "r_verstoesse": {
      "type": "array",
      "description": "Jeder einzelne R-Verstoß mit Fundstelle.",
      "items": {
        "type": "object",
        "required": ["case_id", "family_id", "variante", "repeat_id", "regel", "assertion_id", "rohdatensatz_ids"],
        "additionalProperties": false,
        "properties": {
          "case_id": { "type": "string" },
          "family_id": { "type": "string" },
          "variante": { "type": "string" },
          "repeat_id": { "type": "integer" },
          "regel": { "type": "string" },
          "assertion_id": { "type": "string" },
          "rohdatensatz_ids": { "$ref": "#/$defs/ids" }
        }
      }
    }
  },
  "$defs": {
    "wertfeld": {
      "type": "object",
      "description": "Ein Wert mit den Rohdatensätzen seiner Population; null mit Grund in beleg, wenn unbekannt (nie 0).",
      "required": ["wert", "rohdatensatz_ids", "beleg"],
      "additionalProperties": false,
      "properties": { "wert": { "type": ["number", "null"] }, "rohdatensatz_ids": { "$ref": "#/$defs/ids" }, "beleg": { "type": ["string", "null"] } }
    },
    "differenz": {
      "type": "object",
      "description": "Minuendwert minus Subtrahendwert über die gemeinsamen Fälle (SLV0-EVAL-37); null, wenn eine Seite unbekannt ist oder Methoden sich unterscheiden.",
      "required": ["wert", "minuend_wert", "subtrahend_wert", "rohdatensatz_ids", "beleg"],
      "additionalProperties": false,
      "properties": {
        "wert": { "type": ["number", "null"] },
        "minuend_wert": { "type": ["number", "null"] },
        "subtrahend_wert": { "type": ["number", "null"] },
        "rohdatensatz_ids": { "$ref": "#/$defs/ids" },
        "beleg": { "type": ["string", "null"] }
      }
    },
    "zahl_oder_null": {
      "type": ["object", "null"],
      "required": ["zaehler", "nenner", "rohdatensatz_ids"],
      "additionalProperties": false,
      "properties": { "zaehler": { "type": "integer", "minimum": 0 }, "nenner": { "type": "integer", "minimum": 1 }, "rohdatensatz_ids": { "$ref": "#/$defs/ids" } }
    },
    "kostenbilanz": {
      "type": "object",
      "description": "Kostenbilanz je Ebene (SLV0-EVAL-37/-38, Spec §7.7). Optional, damit frühere Berichte gültig bleiben; der Harness setzt den Block immer.",
      "required": ["je_variante", "differenzen"],
      "additionalProperties": false,
      "properties": {
        "je_variante": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["variante", "laeufe_mit_bilanz", "turns", "usage_turns", "usage_rest", "bytes_gesamt", "bytes_mal_folgeturns_gesamt", "klassen", "kosten_je_erfuelltem_kriterium"],
            "additionalProperties": false,
            "properties": {
              "variante": { "type": "string" },
              "laeufe_mit_bilanz": { "$ref": "#/$defs/zahl" },
              "turns": { "$ref": "#/$defs/wertfeld" },
              "usage_turns": {
                "type": "object",
                "description": "Summe der Turn-Usage nach SLV0-TOK-05.",
                "required": ["input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens"],
                "additionalProperties": false,
                "properties": {
                  "input_tokens": { "$ref": "#/$defs/tokensumme" },
                  "cache_creation_input_tokens": { "$ref": "#/$defs/tokensumme" },
                  "cache_read_input_tokens": { "$ref": "#/$defs/tokensumme" },
                  "output_tokens": { "$ref": "#/$defs/tokensumme" }
                }
              },
              "usage_rest": {
                "type": "object",
                "description": "Summe der Reste (Lauf-Usage minus Turn-Summe), vorzeichenbehaftet.",
                "required": ["input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens"],
                "additionalProperties": false,
                "properties": {
                  "input_tokens": { "$ref": "#/$defs/wertfeld" },
                  "cache_creation_input_tokens": { "$ref": "#/$defs/wertfeld" },
                  "cache_read_input_tokens": { "$ref": "#/$defs/wertfeld" },
                  "output_tokens": { "$ref": "#/$defs/wertfeld" }
                }
              },
              "bytes_gesamt": { "$ref": "#/$defs/wertfeld" },
              "bytes_mal_folgeturns_gesamt": { "$ref": "#/$defs/wertfeld" },
              "klassen": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["klasse", "bloecke", "bytes", "bytes_mal_folgeturns", "tokens"],
                  "additionalProperties": false,
                  "properties": {
                    "klasse": {
                      "type": "string",
                      "pattern": "^(skill_laden|datei_lesen|assistant_text|assistant_denken|assistant_werkzeugaufruf|nutzer_text|unteragent|nicht_zuordenbar|tool_ergebnis:[A-Za-z0-9_.:-]{1,128})$"
                    },
                    "bloecke": { "$ref": "#/$defs/wertfeld" },
                    "bytes": { "$ref": "#/$defs/wertfeld" },
                    "bytes_mal_folgeturns": { "$ref": "#/$defs/wertfeld" },
                    "tokens": { "$ref": "#/$defs/tokensumme" }
                  }
                }
              },
              "kosten_je_erfuelltem_kriterium": {
                "type": "object",
                "description": "Summe der Client-Kostenschätzung geteilt durch die bestandenen Assertions ohne r_regel (SLV0-EVAL-38).",
                "required": ["wert", "quelle", "kosten_usd", "erfuellte_kriterien", "rohdatensatz_ids", "beleg"],
                "additionalProperties": false,
                "properties": {
                  "wert": { "type": ["number", "null"], "minimum": 0 },
                  "quelle": { "enum": ["berechnet", "unbekannt"] },
                  "kosten_usd": { "$ref": "#/$defs/wertfeld" },
                  "erfuellte_kriterien": { "$ref": "#/$defs/zahl_oder_null" },
                  "rohdatensatz_ids": { "$ref": "#/$defs/ids" },
                  "beleg": { "type": ["string", "null"] }
                }
              }
            }
          }
        },
        "differenzen": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["minuend", "subtrahend", "case_ids", "minuend_ids", "subtrahend_ids", "turns", "usage_turns", "usage_rest", "bytes_gesamt", "bytes_mal_folgeturns_gesamt", "klassen", "kosten_usd"],
            "additionalProperties": false,
            "properties": {
              "minuend": { "type": "string" },
              "subtrahend": { "type": "string" },
              "case_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "minuend_ids": { "$ref": "#/$defs/ids" },
              "subtrahend_ids": { "$ref": "#/$defs/ids" },
              "turns": { "$ref": "#/$defs/differenz" },
              "usage_turns": {
                "type": "object",
                "description": "Differenz der Turn-Usage je Feld.",
                "required": ["input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens"],
                "additionalProperties": false,
                "properties": {
                  "input_tokens": { "$ref": "#/$defs/differenz" },
                  "cache_creation_input_tokens": { "$ref": "#/$defs/differenz" },
                  "cache_read_input_tokens": { "$ref": "#/$defs/differenz" },
                  "output_tokens": { "$ref": "#/$defs/differenz" }
                }
              },
              "usage_rest": {
                "type": "object",
                "description": "Differenz der Reste je Feld.",
                "required": ["input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens"],
                "additionalProperties": false,
                "properties": {
                  "input_tokens": { "$ref": "#/$defs/differenz" },
                  "cache_creation_input_tokens": { "$ref": "#/$defs/differenz" },
                  "cache_read_input_tokens": { "$ref": "#/$defs/differenz" },
                  "output_tokens": { "$ref": "#/$defs/differenz" }
                }
              },
              "bytes_gesamt": { "$ref": "#/$defs/differenz" },
              "bytes_mal_folgeturns_gesamt": { "$ref": "#/$defs/differenz" },
              "klassen": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["klasse", "bytes", "bytes_mal_folgeturns"],
                  "additionalProperties": false,
                  "properties": {
                    "klasse": {
                      "type": "string",
                      "pattern": "^(skill_laden|datei_lesen|assistant_text|assistant_denken|assistant_werkzeugaufruf|nutzer_text|unteragent|nicht_zuordenbar|tool_ergebnis:[A-Za-z0-9_.:-]{1,128})$"
                    },
                    "bytes": { "$ref": "#/$defs/differenz" },
                    "bytes_mal_folgeturns": { "$ref": "#/$defs/differenz" }
                  }
                }
              },
              "kosten_usd": { "$ref": "#/$defs/differenz" }
            }
          }
        }
      }
    },
    "ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "zahl": {
      "type": "object",
      "required": ["zaehler", "nenner", "rohdatensatz_ids"],
      "additionalProperties": false,
      "properties": {
        "zaehler": { "type": "integer", "minimum": 0 },
        "nenner": { "type": "integer", "minimum": 1 },
        "rohdatensatz_ids": { "$ref": "#/$defs/ids" }
      }
    },
    "assertblock": {
      "type": ["object", "null"],
      "required": ["bestanden", "nicht_bestanden", "unklar"],
      "additionalProperties": false,
      "properties": {
        "bestanden": { "$ref": "#/$defs/zahl" },
        "nicht_bestanden": { "$ref": "#/$defs/zahl" },
        "unklar": { "$ref": "#/$defs/zahl" }
      }
    },
    "assertions": {
      "type": "object",
      "required": ["deterministisch", "rubrik"],
      "additionalProperties": false,
      "properties": {
        "deterministisch": { "$ref": "#/$defs/assertblock" },
        "rubrik": { "$ref": "#/$defs/assertblock" },
        "nulllauf": {
          "type": ["object", "null"],
          "description": "Deterministische Assertions (ohne R) getrennt nach Nulllauf-Trennschärfe (SLV0-EVAL-24); null ohne deterministische Assertions.",
          "required": ["trennend", "erhaltend", "ungeprueft"],
          "additionalProperties": false,
          "properties": {
            "trennend": { "$ref": "#/$defs/assertblock" },
            "erhaltend": { "$ref": "#/$defs/assertblock" },
            "ungeprueft": { "$ref": "#/$defs/assertblock" }
          }
        },
        "konjunktiv": {
          "type": ["object", "null"],
          "description": "Kern und Gegenkriterium je Stichprobe konjunktiv (SLV0-EVAL-24): Population sind die Rohdatensätze mit beiden Rollen; nie ein Produkt von Mittelwerten. null, wenn kein Rohdatensatz eine Rolle trägt.",
          "required": ["kern_und_gegen", "ohne_kern_oder_gegen"],
          "additionalProperties": false,
          "properties": {
            "kern_und_gegen": { "$ref": "#/$defs/assertblock" },
            "ohne_kern_oder_gegen": { "$ref": "#/$defs/zahl" }
          }
        }
      }
    },
    "tokensumme": {
      "type": "object",
      "required": ["wert", "quelle", "methode", "bezug", "beleg", "rohdatensatz_ids"],
      "additionalProperties": false,
      "properties": {
        "wert": { "type": ["integer", "null"], "minimum": 0 },
        "quelle": { "enum": ["gemeldet", "geschaetzt", "unbekannt"] },
        "methode": { "type": ["string", "null"] },
        "bezug": { "type": "string" },
        "beleg": { "type": ["string", "null"] },
        "rohdatensatz_ids": { "$ref": "#/$defs/ids" }
      }
    },
    "ebene": {
      "type": "object",
      "required": ["laeufe", "assertions", "je_fall", "je_familie", "je_wiederholung", "skill_aufrufe", "katalog_unbekannt", "usage"],
      "additionalProperties": false,
      "properties": {
        "laeufe": {
          "type": "array",
          "description": "Je Variante: abgeschlossene Läufe von allen Läufen.",
          "items": {
            "type": "object",
            "required": ["variante", "abgeschlossen"],
            "additionalProperties": false,
            "properties": { "variante": { "type": "string" }, "abgeschlossen": { "$ref": "#/$defs/zahl" } }
          }
        },
        "assertions": {
          "type": "array",
          "description": "Je Variante, ohne R-Assertions.",
          "items": {
            "type": "object",
            "required": ["variante", "assertions"],
            "additionalProperties": false,
            "properties": { "variante": { "type": "string" }, "assertions": { "$ref": "#/$defs/assertions" } }
          }
        },
        "je_fall": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "variante", "assertions"],
            "additionalProperties": false,
            "properties": { "case_id": { "type": "string" }, "variante": { "type": "string" }, "assertions": { "$ref": "#/$defs/assertions" } }
          }
        },
        "je_familie": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["family_id", "variante", "assertions"],
            "additionalProperties": false,
            "properties": { "family_id": { "type": "string" }, "variante": { "type": "string" }, "assertions": { "$ref": "#/$defs/assertions" } }
          }
        },
        "je_wiederholung": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["case_id", "variante", "repeat_id", "assertions"],
            "additionalProperties": false,
            "properties": { "case_id": { "type": "string" }, "variante": { "type": "string" }, "repeat_id": { "type": "integer" }, "assertions": { "$ref": "#/$defs/assertions" } }
          }
        },
        "skill_aufrufe": {
          "type": "array",
          "description": "Je Variante, Skill und Aktivierungsweg: Läufe mit bestätigtem Aufruf von allen Läufen der Variante. Keine Aussage, ob der Aufruf richtig war.",
          "items": {
            "type": "object",
            "required": ["variante", "skill", "modus", "laeufe_mit_bestaetigtem_aufruf"],
            "additionalProperties": false,
            "properties": {
              "variante": { "type": "string" },
              "skill": { "type": ["string", "null"] },
              "modus": { "enum": ["skill_tool", "file_read"] },
              "laeufe_mit_bestaetigtem_aufruf": { "$ref": "#/$defs/zahl" }
            }
          }
        },
        "katalog_unbekannt": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["variante", "laeufe"],
            "additionalProperties": false,
            "properties": { "variante": { "type": "string" }, "laeufe": { "$ref": "#/$defs/zahl" } }
          }
        },
        "usage": {
          "type": "array",
          "description": "Je Variante Summen der Lauf-Usage nach SLV0-TOK-05 (ein unbekannter Summand macht die Summe unbekannt).",
          "items": {
            "type": "object",
            "required": ["variante", "input_tokens", "output_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"],
            "additionalProperties": false,
            "properties": {
              "variante": { "type": "string" },
              "input_tokens": { "$ref": "#/$defs/tokensumme" },
              "output_tokens": { "$ref": "#/$defs/tokensumme" },
              "cache_read_input_tokens": { "$ref": "#/$defs/tokensumme" },
              "cache_creation_input_tokens": { "$ref": "#/$defs/tokensumme" }
            }
          }
        },
        "kostenbilanz": { "$ref": "#/$defs/kostenbilanz" },
        "gepaart": {
          "type": "array",
          "description": "Gepaarter Vergleich je Variantenpaar (SLV0-EVAL-45/-46, §7.9). Optional, damit frühere Berichte gültig bleiben; der Harness setzt ihn immer.",
          "items": { "$ref": "#/$defs/gepaart" }
        }
      }
    },
    "anzahl_ids": {
      "type": "object",
      "required": ["anzahl", "rohdatensatz_ids"],
      "additionalProperties": false,
      "properties": {
        "anzahl": { "type": "integer", "minimum": 0 },
        "rohdatensatz_ids": { "$ref": "#/$defs/ids" }
      }
    },
    "gepaart": {
      "type": "object",
      "required": ["minuend", "subtrahend", "paare", "auswertbar", "unklar", "beide_bestanden", "nur_minuend_bestanden", "nur_subtrahend_bestanden", "beide_nicht_bestanden", "familien", "mcnemar_p", "differenz_anteil", "intervall_95"],
      "additionalProperties": false,
      "properties": {
        "minuend": { "type": "string" },
        "subtrahend": { "type": "string" },
        "paare": { "$ref": "#/$defs/anzahl_ids" },
        "auswertbar": { "$ref": "#/$defs/zahl" },
        "unklar": { "$ref": "#/$defs/zahl" },
        "beide_bestanden": { "$ref": "#/$defs/zahl_oder_null" },
        "nur_minuend_bestanden": { "$ref": "#/$defs/zahl_oder_null" },
        "nur_subtrahend_bestanden": { "$ref": "#/$defs/zahl_oder_null" },
        "beide_nicht_bestanden": { "$ref": "#/$defs/zahl_oder_null" },
        "familien": { "$ref": "#/$defs/anzahl_ids" },
        "mcnemar_p": { "$ref": "#/$defs/wertfeld" },
        "differenz_anteil": { "$ref": "#/$defs/wertfeld" },
        "intervall_95": {
          "type": "object",
          "required": ["untere", "obere", "ziehungen", "seed", "verfahren"],
          "additionalProperties": false,
          "properties": {
            "untere": { "$ref": "#/$defs/wertfeld" },
            "obere": { "$ref": "#/$defs/wertfeld" },
            "ziehungen": { "type": "integer", "minimum": 100 },
            "seed": { "type": "integer", "minimum": 0 },
            "verfahren": { "type": "string" }
          }
        }
      }
    }
  }
}
